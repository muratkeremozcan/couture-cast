// Step 3 step 1 owner: searchable owner anchor
// Step 4 step 1 owner: searchable owner anchor
// Prisma schema for CoutureCast
// Follows architecture Data Architecture and RLS requirements

generator client {
  provider        = "prisma-client-js"
  // Required to declare PostgreSQL extensions and GIN/trigram index types, so
  // `prisma migrate diff` stays clean against the hand-authored migration.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgTrgm(map: "pg_trgm")]
}

enum ConsentStatus {
  pending
  granted
  revoked
}

enum ConsentLevel {
  read_only
  full_access
}

enum ComfortRun {
  cold
  neutral
  warm
}

enum WindTolerance {
  low
  medium
  high
}

enum PrecipPreparedness {
  low
  medium
  high
}

enum GarmentCategory {
  top
  bottom
  outerwear
  dress
  shoes
  accessory
}

enum GarmentMaterial {
  cotton
  wool
  linen
  leather
  denim
  fleece
  synthetic
  down
  silk
}

enum GarmentComfortRange {
  cold
  cool
  mild
  warm
  hot
}

enum CapsuleOccasion {
  work
  casual
  formal
  sport
  travel
  evening
  outdoor
  home
}

enum GarmentUploadStatus {
  pending_upload
  bytes_uploaded
  processing
  awaiting_tags
  ready
  failed
}

enum GarmentRetentionStatus {
  active
  deletion_pending
  legal_hold
}

model User {
  id                            String                  @id @default(cuid())
  email                         String                  @unique
  created_at                    DateTime                @default(now())
  updated_at                    DateTime                @updatedAt
  profile                       UserProfile?
  comfort_profile               ComfortPreferences?
  garments                      GarmentItem[]
  palette_insights              PaletteInsights[]
  outfits                       OutfitRecommendation[]
  lookbook_posts                LookbookPost[]
  engagement                    EngagementEvent[]
  audit_logs                    AuditLog[]
  guardian_roles                GuardianConsent[]       @relation("GuardianRole")
  teen_roles                    GuardianConsent[]       @relation("TeenRole")
  sent_guardian_invitations     GuardianInvitation[]    @relation("TeenGuardianInvitations")
  accepted_guardian_invitations GuardianInvitation[]    @relation("AcceptedGuardianInvitations")
  moderation_flags              ModerationEvent[]       @relation("FlaggedByRelation")
  moderation_reviews            ModerationEvent[]       @relation("ReviewedByRelation")
  push_tokens                   PushToken[]
  saved_locations               SavedLocation[]
  alert_rules                   AlertRule[]
  notification_preference       NotificationPreference?
  event_envelopes               EventEnvelope[]
  telemetry_events              TelemetryEvent[]
  capsules                      OutfitCapsule[]
  capsule_garments              OutfitCapsuleGarment[]
  capsule_telemetry_claims      CapsuleTelemetryClaim[]
}

/// RLS: user-scoped profile data keyed by user_id
model UserProfile {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [user_id], references: [id])
  user_id          String    @unique
  display_name     String?
  birthdate        DateTime?
  preferences      Json?
  capsule_revision Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
}

model GuardianConsent {
  id                 String        @id @default(cuid())
  guardian           User          @relation("GuardianRole", fields: [guardian_id], references: [id])
  guardian_id        String
  teen               User          @relation("TeenRole", fields: [teen_id], references: [id])
  teen_id            String
  consent_level      ConsentLevel  @default(read_only)
  consent_granted_at DateTime      @default(now())
  revoked_at         DateTime?
  ip_address         String?
  revoked_ip_address String?
  status             ConsentStatus @default(pending)
  created_at         DateTime      @default(now())

  @@unique([guardian_id, teen_id])
  @@index([guardian_id])
  @@index([teen_id])
}

model GuardianInvitation {
  id                   String       @id @default(cuid())
  teen                 User         @relation("TeenGuardianInvitations", fields: [teen_id], references: [id])
  teen_id              String
  guardian_email       String
  consent_level        ConsentLevel @default(read_only)
  expires_at           DateTime
  accepted_at          DateTime?
  accepted_guardian    User?        @relation("AcceptedGuardianInvitations", fields: [accepted_guardian_id], references: [id])
  accepted_guardian_id String?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  // Prisma cannot express the filtered unique index for open invitations; the raw SQL
  // migration enforces one outstanding invite per teen/email while still allowing history.
  @@index([teen_id])
  @@index([guardian_email])
  @@index([accepted_guardian_id])
}

model WeatherSnapshot {
  id                  String            @id @default(cuid())
  location            String
  location_key        String
  latitude            Float
  longitude           Float
  timezone            String
  provider            String
  provider_updated_at DateTime
  temperature         Float
  condition           String
  alerts              Json?
  fetched_at          DateTime          @default(now())
  created_at          DateTime          @default(now())
  segments            ForecastSegment[]

  @@unique([location_key, provider, provider_updated_at])
  @@index([location_key, fetched_at])
}

model ForecastSegment {
  id                        String                 @id @default(cuid())
  weather_snapshot          WeatherSnapshot        @relation(fields: [weather_snapshot_id], references: [id])
  weather_snapshot_id       String
  forecast_at               DateTime
  hour_offset               Int
  temperature               Float
  feels_like                Float
  precipitation_probability Float
  precipitation_amount      Float
  wind_speed                Float
  wind_gust                 Float?
  condition                 String
  provider_weather_code     String
  created_at                DateTime               @default(now())
  outfits                   OutfitRecommendation[]

  @@unique([weather_snapshot_id, forecast_at])
  @@index([forecast_at])
}

model WeatherIngestionState {
  location_key             String    @id
  last_provider_failure_at DateTime?
  last_provider_success_at DateTime?
  updated_at               DateTime  @updatedAt
}

/// RLS: saved weather location preferences are scoped to the owning user_id
model SavedLocation {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  label        String
  location_key String
  latitude     Float
  longitude    Float
  timezone     String
  city         String?
  region       String?
  country      String?
  is_primary   Boolean  @default(false)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([user_id, location_key])
  @@index([user_id, sort_order, created_at, id])
  @@index([location_key])
}

/// RLS: configurable weather alert rules are scoped to the owning user_id
model AlertRule {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  rule_type  String
  threshold  Float
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, rule_type])
  @@index([user_id])
}

/// RLS: notification delivery preferences are scoped to the owning user_id
model NotificationPreference {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id             String   @unique
  quiet_hours_enabled Boolean  @default(false)
  push_enabled        Boolean  @default(true)
  quiet_hours_start   String   @default("22:00")
  quiet_hours_end     String   @default("07:00")
  timezone            String   @default("UTC")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

/// RLS: user-scoped comfort settings enforced by user_id
model ComfortPreferences {
  id                  String             @id @default(cuid())
  user                User               @relation(fields: [user_id], references: [id])
  user_id             String             @unique
  runs_cold_warm      ComfortRun         @default(neutral)
  wind_tolerance      WindTolerance      @default(medium)
  precip_preparedness PrecipPreparedness @default(medium)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
}

/// RLS: wardrobe items must filter by user_id for tenant isolation
// Story 4.2 Task 1 step 1 owner: add garment smart tagging metadata fields and awaiting_tags upload status to Prisma schema in packages/db/prisma/schema.prisma
model GarmentItem {
  id                              String                 @id @default(cuid())
  user                            User                   @relation(fields: [user_id], references: [id])
  user_id                         String
  object_path                     String?                @unique
  image_url                       String?
  category                        GarmentCategory?
  material                        GarmentMaterial?
  comfort_range                   GarmentComfortRange?
  color_palette                   Json?
  tag_suggestions                 Json?
  tagging_model_version           String?
  tag_suggested_at                DateTime?
  tags_confirmed_at               DateTime?
  tagging_failure_code            String?
  tagging_telemetry_emitted_at    DateTime?
  upload_session_id               String?                @unique
  upload_idempotency_key          String?
  commit_idempotency_key          String?
  commit_payload_hash             String?
  file_size_bytes                 Int?
  mime_type                       String?
  content_sha256                  String?
  width_px                        Int?
  height_px                       Int?
  upload_status                   GarmentUploadStatus    @default(pending_upload)
  retention_status                GarmentRetentionStatus @default(active)
  upload_expires_at               DateTime?
  committed_at                    DateTime?
  consent_checked_at              DateTime?
  has_cropping                    Boolean                @default(false)
  has_bg_cleanup                  Boolean                @default(false)
  completion_telemetry_emitted_at DateTime?
  processing_job_enqueued_at      DateTime?
  failure_code                    String?
  retention_trigger               String?
  deletion_requested_at           DateTime?
  /// Set once the purge has actually run. Without it the hourly sweep keeps
  /// re-purging every `deletion_pending` row forever, which re-bumps the
  /// revision of every capsule that contains the garment on every pass.
  retention_purged_at             DateTime?
  created_at                      DateTime               @default(now())
  updated_at                      DateTime               @updatedAt
  palette                         PaletteInsights?       @relation("GarmentPalette")
  moderation_events               ModerationEvent[]
  capsule_joins                   OutfitCapsuleGarment[]

  @@unique([id, user_id])
  @@unique([user_id, upload_idempotency_key])
  @@unique([user_id, commit_idempotency_key])
  @@index([user_id])
  @@index([user_id, upload_status, upload_expires_at])
  @@index([user_id, retention_status, upload_status, updated_at(sort: Desc), id(sort: Asc)], map: "GarmentItem_ritual_candidates_idx")
  @@index([retention_status, deletion_requested_at])
  @@index([retention_status, retention_purged_at, created_at], map: "GarmentItem_retention_purge_sweep_idx")
}

/// RLS: palette insights derived from garments, scoped to user_id
model PaletteInsights {
  id               String         @id @default(cuid())
  garment          GarmentItem    @relation("GarmentPalette", fields: [garment_item_id], references: [id])
  garment_item_id  String         @unique
  user             User           @relation(fields: [user_id], references: [id])
  user_id          String
  undertone        String?
  hex_codes        Json?
  confidence_score Float?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  lookbook_posts   LookbookPost[] @relation("LookbookPalette")

  @@index([user_id])
}

/// RLS: outfit recommendations are cached per user + forecast segment
model OutfitRecommendation {
  id                  String           @id @default(cuid())
  user                User             @relation(fields: [user_id], references: [id])
  user_id             String
  forecast_segment    ForecastSegment? @relation(fields: [forecast_segment_id], references: [id])
  forecast_segment_id String?
  scenario            String
  garment_ids         Json?
  reasoning_badges    Json?
  // Bound by the composite (id, user_id) key so a recommendation can never
  // reference another user's capsule. The database clears only capsule_id on
  // capsule deletion via a column-specific ON DELETE SET NULL, which Prisma
  // cannot express while user_id stays required, so the relation is declared
  // NoAction here and the delete path nulls the reference explicitly.
  capsule             OutfitCapsule?   @relation(fields: [capsule_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction)
  capsule_id          String?
  capsule_revision    Int              @default(0)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  @@unique([user_id, forecast_segment_id, scenario])
  @@index([user_id])
  @@index([capsule_id])
}

/// RLS: lookbook posts tie to user_id and optional palette insight
model LookbookPost {
  id                 String            @id @default(cuid())
  user               User              @relation(fields: [user_id], references: [id])
  user_id            String
  image_urls         Json?
  caption            String?
  locale             String?
  climate_band       String?
  palette_insight    PaletteInsights?  @relation("LookbookPalette", fields: [palette_insight_id], references: [id])
  palette_insight_id String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  engagement_events  EngagementEvent[]
  moderation_events  ModerationEvent[]

  @@index([user_id])
}

/// RLS: engagement events filter by user_id for row-level policies
model EngagementEvent {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [user_id], references: [id])
  user_id    String
  post       LookbookPost @relation(fields: [post_id], references: [id])
  post_id    String
  event_type String
  created_at DateTime     @default(now())

  @@index([user_id])
}

model PushToken {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [user_id], references: [id])
  user_id      String
  token        String   @unique
  platform     String?
  last_used_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([user_id])
}

model EventEnvelope {
  id                    String               @id @default(cuid())
  channel               String
  payload               Json
  user                  User?                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id               String?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  alert_delivery_outbox AlertDeliveryOutbox?

  @@index([channel])
  @@index([created_at])
  @@index([user_id])
}

/// Worker-owned transactional handoff from alert persistence to BullMQ fanout
model AlertDeliveryOutbox {
  id                     String        @id @default(cuid())
  event                  EventEnvelope @relation(fields: [event_id], references: [id], onDelete: Cascade)
  event_id               String        @unique
  deduplication_key      String
  reservation_started_at DateTime
  attempts               Int           @default(0)
  last_error             String?
  dispatched_at          DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  @@index([deduplication_key, reservation_started_at])
  @@index([dispatched_at, created_at])
}

/// Worker-owned rolling cooldown state. No authenticated client policies are granted.
model AlertCooldownReservation {
  deduplication_key String   @id
  next_eligible_at  DateTime
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model JobFailure {
  id            String   @id @default(cuid())
  queue_name    String
  job_id        String
  job_data      Json?
  error_message String
  failed_at     DateTime @default(now())
  attempts      Int
  created_at    DateTime @default(now())

  @@index([queue_name])
  @@index([failed_at])
  @@index([job_id, queue_name])
}

model ModerationEvent {
  id              String        @id @default(cuid())
  post            LookbookPost? @relation(fields: [post_id], references: [id])
  post_id         String?
  garment         GarmentItem?  @relation(fields: [garment_item_id], references: [id])
  garment_item_id String?
  flagged_by      User?         @relation("FlaggedByRelation", fields: [flagged_by_id], references: [id])
  flagged_by_id   String?
  reviewed_by     User?         @relation("ReviewedByRelation", fields: [reviewed_by_id], references: [id])
  reviewed_by_id  String?
  action          String?
  reason          String?
  created_at      DateTime      @default(now())
}

/// RLS: immutable audit trail entries scoped by user_id
model AuditLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  event_type String
  event_data Json?
  timestamp  DateTime @default(now())
  ip_address String?

  @@index([user_id])
  @@index([event_type, timestamp])
}

/// Task 8 step 4 persistence: stores the last known typed value for each
/// canonical flag so the API can keep evaluating flags during PostHog outages.
model FeatureFlag {
  key        String   @id
  value      Json
  updated_at DateTime @updatedAt

  @@map("feature_flags")
}

/// RLS: telemetry events filter by user_id for row-level policies
model TelemetryEvent {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String?
  event_type String
  properties Json
  created_at DateTime @default(now())

  @@index([event_type])
  @@index([created_at])
  @@index([user_id])
  @@map("telemetry_events")
}

/// RLS: outfit capsules are scoped to user_id
model OutfitCapsule {
  id                      String                 @id @default(cuid())
  user                    User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                 String
  name                    String
  description             String?
  occasions               CapsuleOccasion[]
  is_favorite             Boolean                @default(false)
  revision                Int                    @default(0)
  idempotency_key         String?
  idempotency_payload_hash String?
  created_at              DateTime               @default(now())
  updated_at              DateTime               @updatedAt
  garment_joins           OutfitCapsuleGarment[]
  recommendations         OutfitRecommendation[]

  @@unique([id, user_id])
  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([user_id, is_favorite(sort: Desc), updated_at(sort: Desc), id(sort: Asc)])
  @@index([user_id, updated_at(sort: Desc)])
  @@index([user_id, name])
  /// Leading-wildcard case-insensitive search cannot use a btree index.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "OutfitCapsule_name_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "OutfitCapsule_description_trgm_idx", type: Gin)
  /// Array containment for the occasion filter.
  @@index([occasions], map: "OutfitCapsule_occasions_idx", type: Gin)
  @@map("OutfitCapsule")
}

/// One durable claim per state-changing capsule mutation. The unique
/// mutation_key (capsule id, committed revision, event name) is what makes a
/// logical analytics event exactly-once across retries and concurrent callers.
/// Rows are written inside the mutation transaction and delivered after commit.
model CapsuleTelemetryClaim {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  capsule_id   String
  revision     Int
  event_name   String
  mutation_key String    @unique
  payload      Json
  attempts     Int       @default(0)
  last_error   String?
  claimed_at   DateTime  @default(now())
  delivered_at DateTime?

  @@index([delivered_at, claimed_at])
  @@index([user_id])
  @@map("CapsuleTelemetryClaim")
}

/// RLS: outfit capsule garment join table scoped to user_id
model OutfitCapsuleGarment {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String
  capsule       OutfitCapsule @relation(fields: [capsule_id, user_id], references: [id, user_id], onDelete: Cascade)
  capsule_id    String
  garment       GarmentItem   @relation(fields: [garment_id, user_id], references: [id, user_id], onDelete: Cascade)
  garment_id    String
  garment_order Int
  created_at    DateTime      @default(now())

  @@unique([capsule_id, garment_id])
  @@unique([capsule_id, garment_order])
  @@index([user_id])
  @@index([garment_id])
  @@index([capsule_id, garment_order])
  @@map("OutfitCapsuleGarment")
}

