// Step 3 step 1 owner: searchable owner anchor
// Step 4 step 1 owner: searchable owner anchor
// Prisma schema for CoutureCast
// Follows architecture Data Architecture and RLS requirements

generator client {
  provider        = "prisma-client-js"
  // Required to declare PostgreSQL extensions and GIN/trigram index types, so
  // `prisma migrate diff` stays clean against the hand-authored migration.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgTrgm(map: "pg_trgm")]
}

enum ConsentStatus {
  pending
  granted
  revoked
}

enum ConsentLevel {
  read_only
  full_access
}

enum ComfortRun {
  cold
  neutral
  warm
}

enum WindTolerance {
  low
  medium
  high
}

enum PrecipPreparedness {
  low
  medium
  high
}

enum GarmentCategory {
  top
  bottom
  outerwear
  dress
  shoes
  accessory
}

enum GarmentMaterial {
  cotton
  wool
  linen
  leather
  denim
  fleece
  synthetic
  down
  silk
}

enum GarmentComfortRange {
  cold
  cool
  mild
  warm
  hot
}

enum CapsuleOccasion {
  work
  casual
  formal
  sport
  travel
  evening
  outdoor
  home
}

enum GarmentUploadStatus {
  pending_upload
  bytes_uploaded
  processing
  awaiting_tags
  ready
  failed
}

enum GarmentRetentionStatus {
  active
  deletion_pending
  legal_hold
}

/// Story 4.4: server-authoritative wardrobe onboarding progress.
enum WardrobeOnboardingStatus {
  not_started
  in_progress
  completed
}

/// Forward-only step order. The starter-wardrobe skip path moves
/// capture -> silhouette directly; used_starter_wardrobe records that it
/// bypassed tagging rather than adding a distinct step value for it.
enum WardrobeOnboardingStep {
  permission
  capture
  tagging
  silhouette
  complete
}

enum SilhouetteMode {
  default_mannequin
  my_form
}

/// Mirrors GarmentUploadStatus for the "My Form" photo lifecycle specifically
/// (a SilhouetteProfile also holds slider state that has no upload lifecycle).
enum SilhouettePhotoStatus {
  pending_upload
  bytes_uploaded
  processing
  ready
  failed
}

enum SilhouettePhotoFailureReason {
  contrast
  privacy_violation
  timeout
  storage_error
}

/// Story 5.1 decision 10: lowercase members matching their JSON representation
/// one-to-one, so no mapping layer sits between the wire contract and the
/// database.
enum CommercePartnerStatus {
  active
  inactive
}

enum AffiliateOfferStatus {
  active
  inactive
}

enum AffiliateConversionStatus {
  pending
  confirmed
  reversed
}

/// Lowercase members serialize straight to JSON with no mapping layer.
enum BillingProvider {
  stripe
  revenuecat
}

/// Mirrors RevenueCat store values; `promotional` covers RC promotional grants
/// (the operator break-glass path in the premium runbook).
enum EntitlementStore {
  app_store
  play_store
  stripe
  promotional
}

enum PremiumEntitlementStatus {
  active
  grace_period
  expired
  revoked
}

/// Story 5.3: the three shipped premium palettes from the UX Color Theme
/// Explorer (`refs/ux/ux-color-themes.html`). Lowercase members serialize
/// straight to JSON with no mapping layer.
///
/// There is deliberately no `default`/`none` member: an absent selection is
/// already spelled by a NULL `theme`, and a second spelling of the same fact is
/// the trap story 5.2 named for PremiumEntitlementStatus. "Spring Bloom" is
/// marked future in the UX spec and is not a member either.
enum PremiumThemeKey {
  jewel_radiance
  autumn_umber
  winter_metallic
}

/// Story 6.1: Canonical climate bands for grouping regional community feed content.
enum ClimateBand {
  cold_wet
  cold_dry
  temperate_wet
  temperate_dry
  warm_wet
  warm_dry
}

/// Story 6.1: Lifecycle status for community lookbook posts.
enum CommunityPostStatus {
  draft
  uploading
  pending_review
  published
  flagged
  review_failed
  withdrawn
  consent_suspended
}

/// Story 6.1: closed reason set for a community post report. Mirrors
/// `communityReportReasonSchema` in
/// `packages/api-client/src/contracts/http/community.ts`; the parity test in
/// `packages/db/test/community-schema.spec.ts` is what keeps the two in step.
enum CommunityReportReason {
  spam
  harassment
  inappropriate_content
  hate_speech
  violence
  other
}

model User {
  id                            String                       @id @default(cuid())
  email                         String                       @unique
  created_at                    DateTime                     @default(now())
  updated_at                    DateTime                     @updatedAt
  profile                       UserProfile?
  comfort_profile               ComfortPreferences?
  garments                      GarmentItem[]
  palette_insights              PaletteInsights[]
  outfits                       OutfitRecommendation[]
  lookbook_posts                LookbookPost[]
  engagement                    EngagementEvent[]
  audit_logs                    AuditLog[]
  guardian_roles                GuardianConsent[]            @relation("GuardianRole")
  teen_roles                    GuardianConsent[]            @relation("TeenRole")
  sent_guardian_invitations     GuardianInvitation[]         @relation("TeenGuardianInvitations")
  accepted_guardian_invitations GuardianInvitation[]         @relation("AcceptedGuardianInvitations")
  moderation_flags              ModerationEvent[]            @relation("FlaggedByRelation")
  moderation_reviews            ModerationEvent[]            @relation("ReviewedByRelation")
  push_tokens                   PushToken[]
  saved_locations               SavedLocation[]
  alert_rules                   AlertRule[]
  notification_preference       NotificationPreference?
  event_envelopes               EventEnvelope[]
  telemetry_events              TelemetryEvent[]
  capsules                      OutfitCapsule[]
  capsule_garments              OutfitCapsuleGarment[]
  capsule_telemetry_claims      CapsuleTelemetryClaim[]
  wardrobe_onboarding_state     WardrobeOnboardingState?
  silhouette_profile            SilhouetteProfile?
  commerce_preference           CommercePreference?
  affiliate_clicks              AffiliateClick[]
  premium_entitlement           PremiumEntitlement?
  billing_events                BillingEvent[]
  billing_customer              BillingCustomer?
  premium_theme_preference      PremiumThemePreference?
  palette_profile               PaletteProfile?
  advisor_recommendation_states AdvisorRecommendationState[]
  planner_day_plans             PlannerDayPlan[]
  community_alias               CommunityAlias?
  community_reports_filed       CommunityPostReport[]        @relation("CommunityReporter")
}

/// RLS: user-scoped profile data keyed by user_id
model UserProfile {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [user_id], references: [id])
  user_id          String    @unique
  display_name     String?
  birthdate        DateTime?
  preferences      Json?
  capsule_revision Int       @default(0)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
}

model GuardianConsent {
  id                 String        @id @default(cuid())
  guardian           User          @relation("GuardianRole", fields: [guardian_id], references: [id])
  guardian_id        String
  teen               User          @relation("TeenRole", fields: [teen_id], references: [id])
  teen_id            String
  consent_level      ConsentLevel  @default(read_only)
  consent_granted_at DateTime      @default(now())
  revoked_at         DateTime?
  ip_address         String?
  revoked_ip_address String?
  status             ConsentStatus @default(pending)
  created_at         DateTime      @default(now())

  @@unique([guardian_id, teen_id])
  @@index([guardian_id])
  @@index([teen_id])
}

model GuardianInvitation {
  id                   String       @id @default(cuid())
  teen                 User         @relation("TeenGuardianInvitations", fields: [teen_id], references: [id])
  teen_id              String
  guardian_email       String
  consent_level        ConsentLevel @default(read_only)
  expires_at           DateTime
  accepted_at          DateTime?
  accepted_guardian    User?        @relation("AcceptedGuardianInvitations", fields: [accepted_guardian_id], references: [id])
  accepted_guardian_id String?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  // Prisma cannot express the filtered unique index for open invitations; the raw SQL
  // migration enforces one outstanding invite per teen/email while still allowing history.
  @@index([teen_id])
  @@index([guardian_email])
  @@index([accepted_guardian_id])
}

model WeatherSnapshot {
  id                  String            @id @default(cuid())
  location            String
  location_key        String
  latitude            Float
  longitude           Float
  timezone            String
  provider            String
  provider_updated_at DateTime
  temperature         Float
  condition           String
  alerts              Json?
  // Story 5.5 Decision 3: at most eight NormalizedDailyWeatherEntry rows,
  // parsed with the canonical Zod schema on every read.
  daily_summaries     Json?
  fetched_at          DateTime          @default(now())
  created_at          DateTime          @default(now())
  segments            ForecastSegment[]

  @@unique([location_key, provider, provider_updated_at])
  @@index([location_key, fetched_at])
}

model ForecastSegment {
  id                        String                 @id @default(cuid())
  weather_snapshot          WeatherSnapshot        @relation(fields: [weather_snapshot_id], references: [id])
  weather_snapshot_id       String
  forecast_at               DateTime
  hour_offset               Int
  temperature               Float
  feels_like                Float
  precipitation_probability Float
  precipitation_amount      Float
  wind_speed                Float
  wind_gust                 Float?
  condition                 String
  provider_weather_code     String
  created_at                DateTime               @default(now())
  outfits                   OutfitRecommendation[]

  @@unique([weather_snapshot_id, forecast_at])
  @@index([forecast_at])
}

model WeatherIngestionState {
  location_key             String    @id
  last_provider_failure_at DateTime?
  last_provider_success_at DateTime?
  /// DEFAULT CURRENT_TIMESTAMP in the database; see AlertCooldownReservation.
  updated_at               DateTime  @default(now()) @updatedAt
}

/// RLS: saved weather location preferences are scoped to the owning user_id
model SavedLocation {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id           String
  label             String
  location_key      String
  latitude          Float
  longitude         Float
  timezone          String
  city              String?
  region            String?
  country           String?
  is_primary        Boolean          @default(false)
  sort_order        Int              @default(0)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  // Story 5.5 Decision 4: lets PlannerDayPlan carry a composite FK to
  // (location_id, user_id), so a planner row can never reference another
  // user's saved location.
  planner_day_plans PlannerDayPlan[]

  @@unique([user_id, location_key])
  @@unique([id, user_id])
  @@index([user_id, sort_order, created_at, id])
  @@index([location_key])
}

/// RLS: configurable weather alert rules are scoped to the owning user_id
model AlertRule {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  rule_type  String
  threshold  Float
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, rule_type])
  @@index([user_id])
}

/// RLS: notification delivery preferences are scoped to the owning user_id
model NotificationPreference {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id             String   @unique
  quiet_hours_enabled Boolean  @default(false)
  push_enabled        Boolean  @default(true)
  quiet_hours_start   String   @default("22:00")
  quiet_hours_end     String   @default("07:00")
  timezone            String   @default("UTC")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

/// RLS: user-scoped comfort settings enforced by user_id
model ComfortPreferences {
  id                  String             @id @default(cuid())
  user                User               @relation(fields: [user_id], references: [id])
  user_id             String             @unique
  runs_cold_warm      ComfortRun         @default(neutral)
  wind_tolerance      WindTolerance      @default(medium)
  precip_preparedness PrecipPreparedness @default(medium)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
}

/// RLS: wardrobe items must filter by user_id for tenant isolation
// Story 4.2 Task 1 step 1 owner: add garment smart tagging metadata fields and awaiting_tags upload status to Prisma schema in packages/db/prisma/schema.prisma
model GarmentItem {
  id                              String                 @id @default(cuid())
  user                            User                   @relation(fields: [user_id], references: [id])
  user_id                         String
  object_path                     String?                @unique
  image_url                       String?
  category                        GarmentCategory?
  material                        GarmentMaterial?
  comfort_range                   GarmentComfortRange?
  color_palette                   Json?
  tag_suggestions                 Json?
  tagging_model_version           String?
  tag_suggested_at                DateTime?
  tags_confirmed_at               DateTime?
  tagging_failure_code            String?
  tagging_telemetry_emitted_at    DateTime?
  upload_session_id               String?                @unique
  upload_idempotency_key          String?
  commit_idempotency_key          String?
  commit_payload_hash             String?
  file_size_bytes                 Int?
  mime_type                       String?
  content_sha256                  String?
  width_px                        Int?
  height_px                       Int?
  upload_status                   GarmentUploadStatus    @default(pending_upload)
  retention_status                GarmentRetentionStatus @default(active)
  upload_expires_at               DateTime?
  committed_at                    DateTime?
  consent_checked_at              DateTime?
  has_cropping                    Boolean                @default(false)
  has_bg_cleanup                  Boolean                @default(false)
  completion_telemetry_emitted_at DateTime?
  processing_job_enqueued_at      DateTime?
  failure_code                    String?
  retention_trigger               String?
  deletion_requested_at           DateTime?
  /// Set once the purge has actually run. Without it the hourly sweep keeps
  /// re-purging every `deletion_pending` row forever, which re-bumps the
  /// revision of every capsule that contains the garment on every pass.
  retention_purged_at             DateTime?
  created_at                      DateTime               @default(now())
  updated_at                      DateTime               @updatedAt
  palette                         PaletteInsights?       @relation("GarmentPalette")
  moderation_events               ModerationEvent[]
  capsule_joins                   OutfitCapsuleGarment[]

  @@unique([id, user_id])
  @@unique([user_id, upload_idempotency_key])
  @@unique([user_id, commit_idempotency_key])
  @@index([user_id])
  @@index([user_id, upload_status, upload_expires_at])
  @@index([user_id, retention_status, upload_status, updated_at(sort: Desc), id(sort: Asc)], map: "GarmentItem_ritual_candidates_idx")
  @@index([retention_status, deletion_requested_at])
  @@index([retention_status, retention_purged_at, created_at], map: "GarmentItem_retention_purge_sweep_idx")
}

/// RLS: palette insights derived from garments, scoped to user_id
model PaletteInsights {
  id               String         @id @default(cuid())
  garment          GarmentItem    @relation("GarmentPalette", fields: [garment_item_id], references: [id])
  garment_item_id  String         @unique
  user             User           @relation(fields: [user_id], references: [id])
  user_id          String
  undertone        String?
  hex_codes        Json?
  confidence_score Float?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  lookbook_posts   LookbookPost[] @relation("LookbookPalette")

  @@index([user_id])
}

/// RLS: outfit recommendations are cached per user + forecast segment
model OutfitRecommendation {
  id                  String           @id @default(cuid())
  user                User             @relation(fields: [user_id], references: [id])
  user_id             String
  forecast_segment    ForecastSegment? @relation(fields: [forecast_segment_id], references: [id])
  forecast_segment_id String?
  scenario            String
  garment_ids         Json?
  reasoning_badges    Json?
  // Bound by the composite (id, user_id) key so a recommendation can never
  // reference another user's capsule. The database clears only capsule_id on
  // capsule deletion via a column-specific ON DELETE SET NULL, which Prisma
  // cannot express while user_id stays required, so the relation is declared
  // NoAction here and the delete path nulls the reference explicitly.
  capsule             OutfitCapsule?   @relation(fields: [capsule_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction)
  capsule_id          String?
  capsule_revision    Int              @default(0)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  @@unique([user_id, forecast_segment_id, scenario])
  @@index([user_id])
  @@index([capsule_id])
}

/// RLS: API-only. RLS is enabled with zero policies and zero grants to `anon`
/// and `authenticated`, so no direct-to-Postgres client reads or writes this
/// table, not even its owner. The story forbids exposing cross-user rows and
/// forbids client-controlled lifecycle fields, and RLS is row-scoped rather
/// than column-scoped, so neither an owner policy nor a published-read policy
/// can satisfy both. The API serves the allowlisted projection on service_role.
/// See the header of the Story 6.1 migration for the full reasoning.
model LookbookPost {
  id                        String                     @id @default(cuid())
  user                      User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                   String
  status                    CommunityPostStatus        @default(draft)
  caption                   String?
  alt_text                  String?
  /// Opaque `community/<postId>/<random>.<ext>`. Never contains a user id: the
  /// path travels inside every signed URL, so a user id here deanonymizes the
  /// author to anyone the URL is shared with.
  image_object_path         String?
  image_content_type        String?
  image_checksum            String?
  image_byte_size           Int?
  upload_expires_at         DateTime?
  /// When the author confirmed the alt text stored in `alt_text`. The Zod
  /// contract refuses an unconfirmed publish at the HTTP boundary, but a
  /// boundary check leaves no record; without this column nothing downstream
  /// can tell confirmed text from an accepted machine suggestion, which is the
  /// question "Never: Publish unconfirmed alt text" actually asks. Nullable
  /// because `draft` and `uploading` rows have nothing to confirm yet.
  ///
  /// The migration adds `LookbookPost_alt_text_confirmed_when_published`, a
  /// CHECK Prisma cannot express, making the boundary a database invariant
  /// rather than only a contract one.
  alt_text_confirmed_at     DateTime?
  /// When the submission was accepted, which is not `created_at`: the row is
  /// created at allocate time and a replayed allocate reuses it, so counting
  /// `created_at` would charge a retry against the rolling 24-hour cap.
  submitted_at              DateTime?
  published_at              DateTime?
  moderation_reason         String?
  moderation_engine_version String?
  idempotency_key           String?
  location_key              String?
  locale                    String?
  climate_band              ClimateBand?
  palette_insight           PaletteInsights?           @relation("LookbookPalette", fields: [palette_insight_id], references: [id])
  palette_insight_id        String?
  challenge                 CommunityChallenge?        @relation(fields: [challenge_id], references: [id], onDelete: SetNull)
  challenge_id              String?
  moderation_outbox         CommunityModerationOutbox?
  /// Erasure clock. The story requires deletion to complete within 72 hours,
  /// and it completes in three observable steps: the request, the row
  /// anonymization, and the durable removal of the storage object. A sweep
  /// cannot re-drive what it cannot see, so each step has its own timestamp.
  erasure_requested_at      DateTime?
  anonymized_at             DateTime?
  objects_purged_at         DateTime?
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  engagement_events         EngagementEvent[]
  moderation_events         ModerationEvent[]
  reports                   CommunityPostReport[]

  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([challenge_id])
  /// Feed ordering is `published_at, id` DESC, matching the public cursor. The
  /// sort direction is declared here as well as in the migration: without it
  /// Prisma models an ascending index, the SQL creates a descending one, and
  /// `prisma migrate diff` reports permanent drift on both.
  @@index([climate_band, status, published_at(sort: Desc), id(sort: Desc)])
  @@index([status, published_at(sort: Desc), id(sort: Desc)])
  @@index([upload_expires_at])
  @@index([user_id, submitted_at(sort: Desc)])
  @@index([erasure_requested_at, objects_purged_at])
}

/// Story 6.1: the persisted pseudonym a community post is attributed to.
/// RLS: API-only, like every other community table.
///
/// Deriving it instead, as `sha256(userId).slice(0, 4)`, gives 65,536 unsalted
/// buckets over a guessable input: it confirms a guessed user id by hashing, it
/// never rotates, and it collides well below the story's thousand-viewer beta.
/// A stored row with a server-generated random suffix has neither problem.
model CommunityAlias {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String   @unique
  alias      String   @unique
  created_at DateTime @default(now())
}

/// Story 6.1: one abuse report per (post, reporter).
/// RLS: API-only, like every other community table.
///
/// Report uniqueness lives here rather than on ModerationEvent, whose
/// UNIQUE (post_id, flagged_by_id) capped that audit log at one row per actor
/// per post and so made it non-append-only. Both foreign keys are SetNull
/// because neither the subject's account erasure nor the reporter's may destroy
/// a moderation record; the denormalized snapshot, alias and object path below
/// are what keep an orphaned row actionable.
model CommunityPostReport {
  id                String                @id @default(cuid())
  post              LookbookPost?         @relation(fields: [post_id], references: [id], onDelete: SetNull)
  post_id           String?
  reporter          User?                 @relation("CommunityReporter", fields: [reporter_id], references: [id], onDelete: SetNull)
  reporter_id       String?
  reason            CommunityReportReason
  details           String?
  content_snapshot  Json?
  subject_alias     String?
  image_object_path String?
  sla_due_at        DateTime
  created_at        DateTime              @default(now())
  resolved_at       DateTime?

  @@unique([post_id, reporter_id])
  @@index([post_id])
  @@index([reporter_id])
  @@index([resolved_at, sla_due_at])
}

/// Worker-owned transactional handoff from post publish to moderation screening.
/// RLS: API-only, enabled with zero policies and zero grants.
model CommunityModerationOutbox {
  id            String       @id @default(cuid())
  post          LookbookPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id       String       @unique
  attempts      Int          @default(0)
  last_error    String?
  dispatched_at DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@index([dispatched_at, created_at])
}

/// Story 6.1: Editorially curated weekly challenge with optional band
/// restriction (NULL band = global, applies to every band).
///
/// RLS: API-only. A `USING (true)` read policy let any authenticated client
/// enumerate the entire editorial calendar, unstarted and deactivated rows
/// included; challenges reach clients as an API projection of the active window.
///
/// The migration adds two constraints Prisma cannot express and therefore does
/// not manage: `CommunityChallenge_window_ordered` (ends_at > starts_at) and
/// `CommunityChallenge_no_overlap`, a GiST exclusion constraint that rejects two
/// active challenges competing for the same bands over overlapping windows,
/// including the band-versus-global case an equality key cannot catch.
model CommunityChallenge {
  id           String         @id @default(cuid())
  slug         String         @unique
  starts_at    DateTime
  ends_at      DateTime
  /// IANA zone the weekly window is anchored in. Required, and with no default:
  /// a Monday is not a fact until a zone says which instant it begins at, so a
  /// window stored without its zone silently adopts the server's and opens on
  /// the wrong day for part of its audience.
  time_zone    String
  climate_band ClimateBand?
  copy         Json
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  posts        LookbookPost[]

  @@index([is_active, starts_at, ends_at])
  @@index([climate_band, is_active])
}

/// RLS: engagement events filter by user_id for row-level policies
model EngagementEvent {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  post       LookbookPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id    String
  event_type String
  created_at DateTime     @default(now())

  @@index([user_id])
}

model PushToken {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [user_id], references: [id])
  user_id      String
  token        String   @unique
  platform     String?
  last_used_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([user_id])
}

model EventEnvelope {
  id                    String               @id @default(cuid())
  channel               String
  payload               Json
  user                  User?                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id               String?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  alert_delivery_outbox AlertDeliveryOutbox?

  @@index([channel])
  @@index([created_at])
  @@index([user_id])
}

/// Worker-owned transactional handoff from alert persistence to BullMQ fanout
model AlertDeliveryOutbox {
  id                     String        @id @default(cuid())
  event                  EventEnvelope @relation(fields: [event_id], references: [id], onDelete: Cascade)
  event_id               String        @unique
  deduplication_key      String
  reservation_started_at DateTime
  attempts               Int           @default(0)
  last_error             String?
  dispatched_at          DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  /// 20260713170000_add_rolling_alert_cooldowns asked for
  /// `AlertDeliveryOutbox_deduplication_key_reservation_started_at_idx`, which
  /// is 67 characters, so PostgreSQL silently truncated it at its 63-byte
  /// identifier limit and dropped the `_idx`. Prisma truncates the same name
  /// differently (it keeps the suffix, giving `..._started_a_idx`), so without
  /// this map the two disagree forever and `prisma migrate diff` reports a
  /// rename on every clean checkout. The database's name is the real one.
  @@index([deduplication_key, reservation_started_at], map: "AlertDeliveryOutbox_deduplication_key_reservation_started_at_id")
  @@index([dispatched_at, created_at])
}

/// Worker-owned rolling cooldown state. No authenticated client policies are granted.
model AlertCooldownReservation {
  deduplication_key String   @id
  next_eligible_at  DateTime
  created_at        DateTime @default(now())
  /// `@default(now())` describes the database rather than changing it: the
  /// hand-authored migration gave this column DEFAULT CURRENT_TIMESTAMP, and
  /// `@updatedAt` alone emits no default, so the datamodel disagreed with the
  /// column on every clean checkout. Prisma always sends a value here, so the
  /// default only ever serves raw SQL that omits the column.
  updated_at        DateTime @default(now()) @updatedAt
}

model JobFailure {
  id            String   @id @default(cuid())
  queue_name    String
  job_id        String
  job_data      Json?
  error_message String
  failed_at     DateTime @default(now())
  attempts      Int
  created_at    DateTime @default(now())

  @@index([queue_name])
  @@index([failed_at])
  @@index([job_id, queue_name])
}

/// RLS: one row per user recording server-authoritative onboarding progress
/// (decision 3). Absent or `not_started` means the client renders the virtual
/// default; a row is created only once the flow actually starts.
model WardrobeOnboardingState {
  id                             String                   @id @default(cuid())
  user                           User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                        String                   @unique
  status                         WardrobeOnboardingStatus @default(not_started)
  current_step                   WardrobeOnboardingStep   @default(permission)
  used_starter_wardrobe          Boolean                  @default(false)
  garments_captured_count        Int                      @default(0)
  started_at                     DateTime?
  completed_at                   DateTime?
  /// Exactly-once guards for the two onboarding telemetry events (Task 3).
  /// Row creation alone would make "started" exactly-once, but a crash
  /// between commit and emission followed by an identical-payload replay
  /// must not re-emit either event, so both get the same
  /// emitted-at-guarded-updateMany pattern GarmentItem already uses for
  /// completion_telemetry_emitted_at.
  started_telemetry_emitted_at   DateTime?
  completed_telemetry_emitted_at DateTime?
  revision                       Int                      @default(0)
  created_at                     DateTime                 @default(now())
  updated_at                     DateTime                 @updatedAt

  @@index([user_id])
}

/// RLS: one row per user holding the silhouette (mannequin sliders, or a
/// "My Form" photo). The my_form_* columns mirror GarmentItem's upload
/// lifecycle exactly (decision 5); slider and photo state coexist so a user
/// can switch back to sliders after a ready photo without losing either.
model SilhouetteProfile {
  id                             String                        @id @default(cuid())
  user                           User                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                        String                        @unique
  mode                           SilhouetteMode                @default(default_mannequin)
  height_slider                  Int?
  build_slider                   Int?
  my_form_object_path            String?                       @unique
  my_form_upload_session_id      String?                       @unique
  my_form_upload_idempotency_key String?
  my_form_commit_idempotency_key String?
  my_form_commit_payload_hash    String?
  my_form_file_size_bytes        Int?
  my_form_mime_type              String?
  my_form_content_sha256         String?
  my_form_width_px               Int?
  my_form_height_px              Int?
  my_form_upload_expires_at      DateTime?
  my_form_committed_at           DateTime?
  my_form_consent_checked_at     DateTime?
  my_form_status                 SilhouettePhotoStatus?
  my_form_failure_reason         SilhouettePhotoFailureReason?
  my_form_moderation_flagged_at  DateTime?
  my_form_retention_status       GarmentRetentionStatus        @default(active)
  revision                       Int                           @default(0)
  created_at                     DateTime                      @default(now())
  updated_at                     DateTime                      @updatedAt
  moderation_events              ModerationEvent[]

  @@index([user_id])
  @@index([user_id, my_form_status, my_form_upload_expires_at])
}

/// RLS: API-only worker/audit table (Story 6.1). Enabled with zero policies and
/// zero grants; the story names ModerationEvent among the tables no
/// authenticated client may read.
model ModerationEvent {
  id                    String             @id @default(cuid())
  /// SetNull, deliberately not Cascade. LookbookPost.user_id cascades from
  /// User, so chaining a second cascade here made account erasure destroy other
  /// people's abuse reports: a third party reports a post, the author deletes
  /// their account, and the report goes with it. Same reasoning as
  /// BillingEvent.user_id — the audit fact outlives its subject.
  post                  LookbookPost?      @relation(fields: [post_id], references: [id], onDelete: SetNull)
  post_id               String?
  garment               GarmentItem?       @relation(fields: [garment_item_id], references: [id])
  garment_item_id       String?
  silhouette_profile    SilhouetteProfile? @relation(fields: [silhouette_profile_id], references: [id])
  silhouette_profile_id String?
  flagged_by            User?              @relation("FlaggedByRelation", fields: [flagged_by_id], references: [id])
  flagged_by_id         String?
  reviewed_by           User?              @relation("ReviewedByRelation", fields: [reviewed_by_id], references: [id])
  reviewed_by_id        String?
  action                String?
  reason                String?
  /// Denormalized so the row still says something once post_id is nulled: who
  /// it was about (pseudonymously), what the content was, and where the image
  /// object lives so an orphaned object stays findable for purging.
  subject_alias         String?
  content_snapshot      Json?
  image_object_path     String?
  created_at            DateTime           @default(now())

  @@index([post_id])
  @@index([flagged_by_id])
}

/// RLS: immutable audit trail entries scoped by user_id
model AuditLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  event_type String
  event_data Json?
  timestamp  DateTime @default(now())
  ip_address String?

  @@index([user_id])
  @@index([event_type, timestamp])
}

/// Task 8 step 4 persistence: stores the last known typed value for each
/// canonical flag so the API can keep evaluating flags during PostHog outages.
model FeatureFlag {
  key        String   @id
  value      Json
  /// This column is `TIMESTAMPTZ` with microsecond precision and a
  /// CURRENT_TIMESTAMP default, because 20260314160000_add_feature_flags wrote
  /// it by hand that way, while every Prisma-generated timestamp in this schema
  /// is `timestamp(3)` without a time zone. The annotations below describe the
  /// column that exists; they change no data and no behaviour, since the query
  /// engine reads the column's real type off the wire either way.
  ///
  /// Normalising the column to `timestamp(3)` to match the rest of the schema
  /// would be an `ALTER COLUMN TYPE` that rewrites the table and reinterprets
  /// stored values, which is an owner's decision, not a drift cleanup.
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("feature_flags")
}

/// RLS: telemetry events filter by user_id for row-level policies
model TelemetryEvent {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String?
  event_type String
  properties Json
  created_at DateTime @default(now())

  @@index([event_type])
  @@index([created_at])
  @@index([user_id])
  @@map("telemetry_events")
}

/// RLS: outfit capsules are scoped to user_id
model OutfitCapsule {
  id                       String                 @id @default(cuid())
  user                     User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                  String
  name                     String
  description              String?
  occasions                CapsuleOccasion[]
  is_favorite              Boolean                @default(false)
  revision                 Int                    @default(0)
  idempotency_key          String?
  idempotency_payload_hash String?
  created_at               DateTime               @default(now())
  updated_at               DateTime               @updatedAt
  garment_joins            OutfitCapsuleGarment[]
  recommendations          OutfitRecommendation[]

  @@unique([id, user_id])
  @@unique([user_id, idempotency_key])
  @@index([user_id])
  @@index([user_id, is_favorite(sort: Desc), updated_at(sort: Desc), id(sort: Asc)])
  @@index([user_id, updated_at(sort: Desc)])
  @@index([user_id, name])
  /// Leading-wildcard case-insensitive search cannot use a btree index.
  @@index([name(ops: raw("gin_trgm_ops"))], map: "OutfitCapsule_name_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "OutfitCapsule_description_trgm_idx", type: Gin)
  /// Array containment for the occasion filter.
  @@index([occasions], map: "OutfitCapsule_occasions_idx", type: Gin)
  @@map("OutfitCapsule")
}

/// One durable claim per state-changing capsule mutation. The unique
/// mutation_key (capsule id, committed revision, event name) is what makes a
/// logical analytics event exactly-once across retries and concurrent callers.
/// Rows are written inside the mutation transaction and delivered after commit.
model CapsuleTelemetryClaim {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      String
  capsule_id   String
  revision     Int
  event_name   String
  mutation_key String    @unique
  payload      Json
  attempts     Int       @default(0)
  last_error   String?
  claimed_at   DateTime  @default(now())
  delivered_at DateTime?

  @@index([delivered_at, claimed_at])
  @@index([user_id])
  @@map("CapsuleTelemetryClaim")
}

/// RLS: outfit capsule garment join table scoped to user_id
model OutfitCapsuleGarment {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String
  capsule       OutfitCapsule @relation(fields: [capsule_id, user_id], references: [id, user_id], onDelete: Cascade)
  capsule_id    String
  garment       GarmentItem   @relation(fields: [garment_id, user_id], references: [id, user_id], onDelete: Cascade)
  garment_id    String
  garment_order Int
  created_at    DateTime      @default(now())

  @@unique([capsule_id, garment_id])
  @@unique([capsule_id, garment_order])
  @@index([user_id])
  @@index([garment_id])
  @@index([capsule_id, garment_order])
  @@map("OutfitCapsuleGarment")
}

/// Story 5.1: an operator-managed affiliate partner. No admin console exists;
/// rows arrive by seed or migration. Carries no user_id, so RLS is enabled with
/// no grant to the `authenticated` role.
model CommercePartner {
  id                 String                @id @default(cuid())
  slug               String                @unique
  display_name       String
  /// Registrable host the outbound deep link must equal, or be a dot-suffix of,
  /// after IDN normalization. `shop.example.com` matches `example.com`;
  /// `notexample.com` does not.
  allowed_host       String
  status             CommercePartnerStatus @default(inactive)
  /// The NAME of the environment variable holding this partner's webhook
  /// signing secret, never the secret itself. A check constraint pins it to
  /// ^COMMERCE_PARTNER_[A-Z0-9_]{1,40}_WEBHOOK_SECRET$ so a database row can
  /// never address an arbitrary environment variable.
  webhook_secret_ref String
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt
  offers             AffiliateOffer[]
  clicks             AffiliateClick[]
  conversions        AffiliateConversion[]

  @@index([status, slug])
  @@map("CommercePartner")
}

/// Story 5.1: one publication row per (partner, garment slot, region) window.
/// `comfort_range` NULL is the wildcard. An exact comfort_range match outranks a
/// wildcard regardless of `priority`, and `id ASC` is the total tie-break, which
/// is what keeps attribution comparable and end-to-end assertions stable.
///
/// Story 5.4: extended, not forked, to also carry beauty/accessory advisor
/// offers. `garment_category` and `advisor_slot` are mutually exclusive and
/// exactly one is set (migration check constraint `num_nonnulls(garment_category,
/// advisor_slot) = 1`), so every row is unambiguously a garment offer or an
/// advisor offer. `advisor_undertone` NULL is the wildcard, exactly like
/// `comfort_range` above, and follows the identical ORDER BY ranking rule.
/// One index on this table is deliberately NOT declared below:
///
///   AffiliateOffer_status_locale_region_advisor_slot_priority_idx
///     ON ("status", "locale_region", "advisor_slot", "priority" DESC)
///     WHERE "advisor_slot" IS NOT NULL
///
/// created by 20260825090000_add_palette_advisor. It is PARTIAL, and the Prisma
/// DSL cannot say `WHERE`. The predicate is load-bearing: without it this index
/// and the garment index below are structurally tied on a garment-only query,
/// the planner may pick either, and that regressed
/// commerce-affiliate-offers-query-plan.integration.spec.ts's 5.1-PLAN-03.
///
/// It used to be declared here anyway, as a plain `@@index`. That was worse
/// than not declaring it: Prisma's introspection skips partial indexes, so it
/// never saw the real object, `prisma migrate diff` reported permanent drift on
/// a clean checkout, and the next `migrate dev` would have emitted a
/// `CREATE INDEX` under a name the database already holds. Leaving it
/// undeclared is the honest description -- Prisma does not manage this index --
/// and it cannot drop what it cannot see. `packages/db/test/palette-advisor-schema.spec.ts`
/// (5.4-DB-041) is what guards the object itself.
model AffiliateOffer {
  id                 String               @id @default(cuid())
  partner            CommercePartner      @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  partner_id         String
  garment_category   GarmentCategory?
  comfort_range      GarmentComfortRange?
  advisor_slot       AdvisorSlot?
  advisor_undertone  SkinUndertone?
  /// The uppercased region subtag of the UI language, or the '*' sentinel
  /// meaning "published globally". This is NOT a commerce jurisdiction: a user
  /// in the US reading the app in fr-FR resolves to FR and sees FR offers.
  locale_region      String
  title              String
  /// Contains the literal {clickToken} placeholder. A template without it is
  /// rejected at click time as operator misconfiguration.
  deep_link_template String
  priority           Int                  @default(0)
  status             AffiliateOfferStatus @default(inactive)
  /// Inclusive lower bound of the publication window.
  effective_from     DateTime
  /// Exclusive upper bound; NULL means open-ended.
  effective_to       DateTime?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  clicks             AffiliateClick[]

  @@index([status, locale_region, garment_category, priority(sort: Desc)])
  @@index([partner_id])
  @@map("AffiliateOffer")
}

/// RLS: owner-only, deliberately NOT guardian-shared. A purchase-intent signal
/// is not something story 5.1 has a mandate to expose to a guardian.
model CommercePreference {
  id                     String   @id @default(cuid())
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                String   @unique
  affiliate_ctas_enabled Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@map("CommercePreference")
}

/// RLS: owner-only. A durable commercial record minted on an explicit tap.
/// Retained 24 months by the commerce pruner in `CommerceRetentionService`, and
/// deliberately out of reach of the hourly telemetry pruner beside it.
model AffiliateClick {
  id                String                @id @default(cuid())
  /// base64url HMAC-SHA256 over `id`, keyed by COMMERCE_CLICK_TOKEN_SECRET.
  /// This, never `id`, is what reaches a partner URL and what the webhook joins
  /// on: a raw cuid in a third-party URL would let any holder of a partner
  /// secret attribute revenue to guessed identifiers.
  token             String                @unique
  user              User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id           String
  offer             AffiliateOffer        @relation(fields: [offer_id], references: [id], onDelete: Restrict)
  offer_id          String
  partner           CommercePartner       @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  partner_id        String
  /// For a garment-slot click: the ScenarioOutfit.id the CTA was rendered on,
  /// joining impression to click for the PRD's click-through metric. Story 5.4:
  /// for an advisor click (`offer.advisor_slot !== null`) this instead carries
  /// PaletteProfile.id, which keeps the 60-second dedupe index
  /// (user_id, offer_id, recommendation_id, minute) meaningful, since an offer
  /// belongs to exactly one advisor slot and so cannot legitimately be clicked
  /// twice in a minute from two places.
  recommendation_id String
  scenario          String
  surface           String
  locale_region     String
  created_at        DateTime              @default(now())
  conversions       AffiliateConversion[]

  @@index([user_id])
  @@index([created_at])
  @@index([user_id, offer_id, recommendation_id, created_at(sort: Desc)])
  @@map("AffiliateClick")
}

/// Story 5.1: append-only. One row per (partner, partner-side event id), never
/// updated. That removes the ordering problem entirely: there is no
/// last-write-wins rule and no forbidden-transition table, because nothing
/// mutates. A click's current attribution state is the row with the greatest
/// `occurred_at`, computed at read time by whoever reports on it.
model AffiliateConversion {
  id                      String                    @id @default(cuid())
  partner                 CommercePartner           @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  partner_id              String
  external_event_id       String
  /// NULL when the posted click token matched nothing, and set NULL when the
  /// clicking user is erased: the financial fact survives as an unattributed
  /// record while the personal link is destroyed.
  affiliate_click         AffiliateClick?           @relation(fields: [affiliate_click_id], references: [id], onDelete: SetNull)
  affiliate_click_id      String?
  status                  AffiliateConversionStatus
  /// Integer minor units. Floating-point money is prohibited.
  order_value_minor_units Int
  currency                String
  occurred_at             DateTime
  received_at             DateTime                  @default(now())

  @@unique([partner_id, external_event_id])
  @@index([affiliate_click_id, occurred_at(sort: Desc)])
  @@index([received_at])
  @@map("AffiliateConversion")
}

/// Story 5.2: mirror of the RevenueCat entitlement ledger — our database
/// mirrors, never originates, entitlement state. RLS: worker-only. Zero client
/// policies, zero grants: a client-forgeable entitlement row is free Premium.
model PremiumEntitlement {
  id                     String                   @id @default(cuid())
  user                   User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                String                   @unique
  status                 PremiumEntitlementStatus
  store                  EntitlementStore
  /// 'premium_monthly' | 'premium_annual' today; deliberately unconstrained so
  /// the operator can add products without a migration.
  product_id             String
  will_renew             Boolean
  /// UTC in timestamp-without-tz; every SQL clock comparison goes through
  /// `now() AT TIME ZONE 'UTC'`.
  current_period_end     DateTime
  /// Last successful sync from the ledger (webhook apply or REST pull).
  synced_at              DateTime
  /// Ordering guard: apply an event iff occurred_at is newer, or equal with a
  /// distinct event id. Strictly-older events are dropped.
  last_event_occurred_at DateTime
  /// Provider event id of the last applied event ('pull:<cuid>' for REST pulls).
  last_event_id          String
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt

  @@map("PremiumEntitlement")
}

/// Story 5.2: append-only receipt log — the "receipts stored securely" record.
/// RLS: worker-only. `payload` is an allowlisted projection, never a raw
/// provider body. An UPDATE-blocking trigger in the migration enforces
/// append-only; DELETE stays open for the 24-month retention pruner.
model BillingEvent {
  id                 String            @id @default(cuid())
  provider           BillingProvider
  /// RevenueCat event.id / Stripe event.id
  external_event_id  String
  /// Provider's own type string, e.g. 'INITIAL_PURCHASE', 'customer.subscription.updated'
  event_type         String
  /// SetNull so financial facts survive account erasure as unattributed rows.
  user               User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  user_id            String?
  store              EntitlementStore?
  product_id         String?
  payload            Json
  occurred_at        DateTime
  received_at        DateTime          @default(now())
  /// Forward obligation (Stripe checkout events only). NULL-equivalent default
  /// false = nothing to forward. A due-but-unforwarded row is re-driven by the
  /// reconciliation sweep until forwarded_at is set; a dropped forward would be
  /// an unrecoverable lost payment, so this is an outbox, never fire-and-forget.
  forward_due        Boolean           @default(false)
  forwarded_at       DateTime?
  forward_attempts   Int               @default(0)
  forward_last_error String?

  @@unique([provider, external_event_id])
  @@index([received_at])
  @@index([forward_due, forwarded_at])
  @@map("BillingEvent")
}

/// Story 5.2: Stripe customer mapping so Checkout/Portal sessions reuse one
/// customer. Upserted at checkout-session creation time, not webhook time.
/// RLS: worker-only.
model BillingCustomer {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id            String   @unique
  stripe_customer_id String   @unique
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("BillingCustomer")
}

/// Story 5.3: the signed-in user's premium palette choice, one row per user.
/// RLS: owner-only (selfOnlyTables), same template as CommercePreference and
/// deliberately NOT guardian-shared. A cosmetic preference is not
/// privilege-bearing — unlike PremiumEntitlement, this table is safe for the
/// authenticated user to read and write directly.
///
/// Absent row and `theme = NULL` both mean Default, and nothing may branch on
/// which of the two it is. Reset is an upsert to NULL, never a DELETE: the row
/// appears the first time a user opens the gallery and is never removed after,
/// not on reset and not when entitlement lapses (entitlement is resolved at
/// read time, so a stale row simply stops rendering).
model PremiumThemePreference {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String           @unique
  theme      PremiumThemeKey?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  @@map("PremiumThemePreference")
}

// ---------------------------------------------------------------------------
// Story 5.4: Color palette & beauty/accessory advisor
// ---------------------------------------------------------------------------

enum PaletteSource {
  selfie
  wardrobe
}

enum SkinUndertone {
  warm
  cool
  neutral
  olive
}

enum SkinDepth {
  fair
  light
  medium
  tan
  deep
}

/// Mirrors SilhouettePhotoStatus. The wardrobe source jumps straight to
/// `processing` (there is nothing to upload), which is why the upload statuses
/// are nullable rather than a required starting state.
enum PaletteAnalysisStatus {
  pending_upload
  bytes_uploaded
  processing
  ready
  failed
}

enum PaletteAnalysisFailureReason {
  no_face
  low_quality
  privacy_violation
  insufficient_wardrobe
  timeout
  storage_error
}

enum AdvisorSlot {
  foundation
  blush
  jewelry
  bag
  eyewear
}

enum AdvisorAction {
  saved
  dismissed
}

/// RLS: owner-only (selfOnlyTables). One row per user. Holds the consent fact,
/// the derived palette scalars, and the transient selfie upload lifecycle.
/// The selfie BYTES never outlive the analysis (decision 8): selfie_purged_at
/// is stamped when the object is removed, and nothing here is a signed URL.
model PaletteProfile {
  id                            String                        @id @default(cuid())
  user                          User                          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                       String                        @unique
  consent_granted_at            DateTime?
  consent_revoked_at            DateTime?
  source                        PaletteSource?
  undertone                     SkinUndertone?
  depth                         SkinDepth?
  confidence                    Float?
  analysis_version              String?
  analyzed_at                   DateTime?
  status                        PaletteAnalysisStatus?
  failure_reason                PaletteAnalysisFailureReason?
  selfie_object_path            String?                       @unique
  selfie_upload_session_id      String?                       @unique
  selfie_upload_idempotency_key String?
  selfie_commit_idempotency_key String?
  selfie_commit_payload_hash    String?
  selfie_file_size_bytes        Int?
  selfie_mime_type              String?
  selfie_content_sha256         String?
  selfie_width_px               Int?
  selfie_height_px              Int?
  selfie_upload_expires_at      DateTime?
  selfie_committed_at           DateTime?
  selfie_purged_at              DateTime?
  revision                      Int                           @default(0)
  created_at                    DateTime                      @default(now())
  updated_at                    DateTime                      @updatedAt

  @@index([user_id])
  @@index([user_id, status, selfie_upload_expires_at])
  @@map("PaletteProfile")
}

/// RLS: owner-only. One row per saved-or-dismissed suggestion. item_key is the
/// rule table's stable id (decision 6), never a translated label.
model AdvisorRecommendationState {
  id         String        @id @default(cuid())
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String
  slot       AdvisorSlot
  item_key   String
  action     AdvisorAction
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@unique([user_id, slot, item_key])
  @@index([user_id])
  @@map("AdvisorRecommendationState")
}

enum PlannerOutfitSource {
  generated
  reshuffled
}

/// RLS: owner-only (selfOnlyTables). One disposable cache row per user,
/// saved location, and calendar date -- Decision 4. `plan_payload` is
/// validated with an internal strict Zod schema on every read; a garment or
/// capsule id referenced inside it is re-checked for ownership and
/// eligibility at read time, never trusted from the stored JSON alone.
model PlannerDayPlan {
  id                     String              @id @default(cuid())
  user                   User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id                String
  location               SavedLocation       @relation(fields: [location_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction)
  location_id            String
  plan_date              DateTime            @db.Date
  locale                 String
  dependency_fingerprint String
  plan_payload           Json
  source                 PlannerOutfitSource @default(generated)
  version                Int                 @default(1)
  reshuffle_count        Int                 @default(0)
  generated_at           DateTime            @default(now())
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt

  @@unique([user_id, location_id, plan_date])
  @@index([user_id, plan_date])
  @@map("PlannerDayPlan")
}
