{
  "name": "@couture/db",
  "private": true,
  "version": "0.1.0",
  "description": "CoutureCast Prisma schema, migrations, and seeds",
  "type": "module",
  "scripts": {
    "db:migrate": "prisma migrate dev",
    "prepare:shared-deps": "npm run db:generate && npm run build --workspace @couture/utils && npm run build --workspace @couture/testing",
    "predb:seed": "npm run prepare:shared-deps",
    "db:seed": "prisma db seed",
    "predb:reset": "npm run prepare:shared-deps",
    "db:reset": "prisma migrate reset --force --skip-seed && prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "npx prisma generate",
    "prelint": "npm run prepare:shared-deps",
    "lint": "eslint --max-warnings=0 --ext .ts prisma/seeds test vitest.config.ts",
    "pretypecheck": "npm run prepare:shared-deps",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json",
    "pretest": "npm run prepare:shared-deps",
    "test": "vitest run --config vitest.config.ts",
    "pretest:coverage": "npm run prepare:shared-deps",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@faker-js/faker": "10.1.0",
    "@prisma/client": "6.19.0"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seeds/index.ts"
  }
}
