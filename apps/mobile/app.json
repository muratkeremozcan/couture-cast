{
  "expo": {
    "name": "Couture Cast",
    "slug": "couture-cast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "owner": "muratkerem",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.couturecast.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.couturecast.app",
      "versionCode": 6,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "./plugins/with-widgets",
      "./plugins/with-watchos",
      "./plugins/with-supported-ios-target",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C9A14A",
          "defaultChannel": "community"
        }
      ],
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow CoutureCast to choose wardrobe photos.",
          "savePhotosPermission": "Allow CoutureCast to save the card you approve to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CoutureCast to choose wardrobe photos.",
          "cameraPermission": "Allow CoutureCast to photograph wardrobe items.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "340f5908-84cd-492e-bc59-2909fca66e9e"
      }
    },
    "locales": {
      "de-DE": "./locales/de-DE.json",
      "en-CA": "./locales/en-CA.json",
      "en-US": "./locales/en-US.json",
      "es-419": "./locales/es-419.json",
      "fr-CA": "./locales/fr-CA.json",
      "fr-FR": "./locales/fr-FR.json",
      "it-IT": "./locales/it-IT.json",
      "pt-BR": "./locales/pt-BR.json",
      "pt-PT": "./locales/pt-PT.json",
      "tr-TR": "./locales/tr-TR.json"
    }
  }
}
