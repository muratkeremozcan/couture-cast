      "field": "caption",
      "text": "Kemer köprülerden geçiyor."
    },
    {
      "id": "tr-holdout-v2-147",
      "field": "caption",
      "text": "Etek yandan kapanıyor."
    },
    {
      "id": "tr-holdout-v2-148",
      "field": "caption",
      "text": "Okuma salonu için bir şal."
    },
    {
      "id": "tr-holdout-v2-149",
      "field": "caption",
      "text": "Botlarımın topukları alçak."
    },
    {
      "id": "tr-holdout-v2-150",
      "field": "caption",
      "text": "Kolda görünen bir dikiş var."
    },
    {
      "id": "tr-holdout-v2-151",
      "field": "caption",
      "text": "Mezuniyet takımımı giyiyorum."
    },
    {
      "id": "tr-holdout-v2-152",
      "field": "caption",
      "text": "Bluzun omuzları büzgülü."
    },
    {
      "id": "tr-holdout-v2-153",
      "field": "caption",
      "text": "Düğmeler küçük deniz kabuklarına benziyor."
    },
    {
      "id": "tr-holdout-v2-154",
      "field": "caption",
      "text": "Fular yeşil cekete eşlik ediyor."
    },
    {
      "id": "tr-holdout-v2-155",
      "field": "caption",
      "text": "Elbise bavula sığıyor."
    },
    {
      "id": "tr-holdout-v2-156",
      "field": "caption",
      "text": "İki manşeti de daralttım."
    },
    {
      "id": "tr-holdout-v2-157",
      "field": "caption",
      "text": "Kumaş parçalarından küçük bir kese."
    },
    {
      "id": "tr-holdout-v2-158",
      "field": "caption",
      "text": "Bu pantolonla bisiklete binebiliyorum."
    },
    {
      "id": "tr-holdout-v2-159",
      "field": "caption",
      "text": "Ayakkabılar yakındaki atölyeden geldi."
    },
    {
      "id": "tr-holdout-v2-160",
      "field": "caption",
      "text": "Şapka askıda duruyor."
    },
    {
      "id": "tr-holdout-v2-161",
      "field": "caption",
      "text": "Cep astarını yeniden diktim."
    },
    {
      "id": "tr-holdout-v2-162",
      "field": "caption",
      "text": "Bilekliğin küçük bir kilidi var."
    },
    {
      "id": "tr-holdout-v2-163",
      "field": "caption",
      "text": "Bu pelerin sırt çantamı örtüyor."
    },
    {
      "id": "tr-holdout-v2-164",
      "field": "caption",
      "text": "Okuma gecesi için bir gömlek."
    },
    {
      "id": "tr-holdout-v2-165",
      "field": "caption",
      "text": "Sandaletlerin bantları geniş."
    },
    {
      "id": "tr-holdout-v2-166",
      "field": "caption",
      "text": "Etek merdivenlerde adımlarıma uyuyor."
    },
    {
      "id": "tr-holdout-v2-167",
      "field": "caption",
      "text": "Kazağın omuzları düşük."
    },
    {
      "id": "tr-holdout-v2-168",
      "field": "caption",
      "text": "Kemeri maviye boyadım."
    },
    {
      "id": "tr-holdout-v2-169",
      "field": "caption",
      "text": "Bu önlük kollarımı koruyor."
    },
    {
      "id": "tr-holdout-v2-170",
      "field": "caption",
      "text": "Atkım sedir kokuyor."
    },
    {
      "id": "tr-holdout-v2-171",
      "field": "caption",
      "text": "Ceketin cepleri derin."
    },
    {
      "id": "tr-holdout-v2-172",
      "field": "caption",
      "text": "Çıkarılabilir yaka elbiseyi değiştiriyor."
    },
    {
      "id": "tr-holdout-v2-173",
      "field": "caption",
      "text": "Bütün hafta bu broşu taktım."
    },
    {
      "id": "tr-holdout-v2-174",
      "field": "caption",
      "text": "Eldivenler kutularına dönüyor."
    },
    {
      "id": "tr-holdout-v2-175",
      "field": "caption",
      "text": "Çantanın tabanı güçlendirilmiş."
    },
    {
      "id": "tr-holdout-v2-176",
      "field": "caption",
      "text": "Bu etek ablamdan geldi."
    },
    {
      "id": "tr-holdout-v2-177",
      "field": "caption",
      "text": "Buluşma için yeni bir pantolon."
    },
    {
      "id": "tr-holdout-v2-178",
      "field": "caption",
      "text": "Berenin kıvrımı geniş."
    },
    {
      "id": "tr-holdout-v2-179",
      "field": "caption",
      "text": "Gömleğimde küçük bir işleme var."
    },
    {
      "id": "tr-holdout-v2-180",
      "field": "caption",
      "text": "Dün botlarımı cilaladım."
    },
    {
      "id": "tr-holdout-v2-181",
      "field": "caption",
      "text": "Elbise yandan bağlanıyor."
    },
    {
      "id": "tr-holdout-v2-182",
      "field": "caption",
      "text": "Ayakkabılar yeni tabanlarını bekliyor."
    },
    {
      "id": "tr-holdout-v2-183",
      "field": "caption",
      "text": "Şapka için açık renk kurdele."
    },
    {
      "id": "tr-holdout-v2-184",
      "field": "caption",
      "text": "Dedemin ceketini giydim."
    },
    {
      "id": "tr-holdout-v2-185",
      "field": "caption",
      "text": "Bu kazak çizim yaparken benimle."
    },
    {
      "id": "tr-holdout-v2-186",
      "field": "caption",
      "text": "Kemerin yuvarlak tokası var."
    },
    {
      "id": "tr-holdout-v2-187",
      "field": "caption",
      "text": "Çantada katlanır baston var."
    },
    {
      "id": "tr-holdout-v2-188",
      "field": "caption",
      "text": "Palto içeride açık kalıyor."
    },
    {
      "id": "tr-holdout-v2-189",
      "field": "caption",
      "text": "Atkı yakadan görünüyor."
    },
    {
      "id": "tr-holdout-v2-190",
      "field": "caption",
      "text": "Akşam yemeğinde el örgüsü çoraplar."
    },
    {
      "id": "tr-holdout-v2-191",
      "field": "caption",
      "text": "Bluzun kumaşı serin tutuyor."
    },
    {
      "id": "tr-holdout-v2-192",
      "field": "caption",
      "text": "Anvelop bir etek seçtim."
    },
    {
      "id": "tr-holdout-v2-193",
      "field": "caption",
      "text": "Botların dikişleri kırmızı."
    },
    {
      "id": "tr-holdout-v2-194",
      "field": "caption",
      "text": "Satranç dersi için bir yelek."
    },
    {
      "id": "tr-holdout-v2-195",
      "field": "caption",
      "text": "Gömleğin çift manşeti var."
    },
    {
      "id": "tr-holdout-v2-196",
      "field": "caption",
      "text": "Çantanın askısını güçlendirdim."
    },
    {
      "id": "tr-holdout-v2-197",
      "field": "caption",
      "text": "Fular saçlarıma bağlanıyor."
    },
    {
      "id": "tr-holdout-v2-198",
      "field": "caption",
      "text": "Paltoma yeni bir halka diktim."
    },
    {
      "id": "tr-holdout-v2-199",
      "field": "caption",
      "text": "Elbise dikiş atölyesinden çıktı."
    },
    {
      "id": "tr-holdout-v2-200",
      "field": "caption",
      "text": "Bu eldivenlerin astarı pamuklu."
    },
    {
      "id": "tr-holdout-v2-201",
      "field": "altText",
      "text": "Yuvarlak yakalı mavi bluz."
    },
    {
      "id": "tr-holdout-v2-202",
      "field": "altText",
      "text": "Sandalyede gri palto."
    },
    {
      "id": "tr-holdout-v2-203",
      "field": "altText",
      "text": "Geniş pileli yeşil etek."
    },
    {
      "id": "tr-holdout-v2-204",
      "field": "altText",
      "text": "Kapının önünde kahverengi botlar."
    },
    {
      "id": "tr-holdout-v2-205",
      "field": "altText",
      "text": "Klapanın altında kırmızı atkı."
    },
    {
      "id": "tr-holdout-v2-206",
      "field": "altText",
      "text": "Örgü bantlı açık renk şapka."
    },
    {
      "id": "tr-holdout-v2-207",
      "field": "altText",
      "text": "Açık fayanslarda siyah ayakkabılar."
    },
    {
      "id": "tr-holdout-v2-208",
      "field": "altText",
      "text": "Kare cepli kapitone yelek."
    },
    {
      "id": "tr-holdout-v2-209",
      "field": "altText",
      "text": "Duvarın yanında sarı çanta."
    },
    {
      "id": "tr-holdout-v2-210",
      "field": "altText",
      "text": "Bankın üstünde yün eldivenler."
    },
    {
      "id": "tr-holdout-v2-211",
      "field": "altText",
      "text": "İşlemeli manşetli beyaz gömlek."
    },
    {
      "id": "tr-holdout-v2-212",
      "field": "altText",
      "text": "Paçası kıvrılmış mavi pantolon."
    },
    {
      "id": "tr-holdout-v2-213",
      "field": "altText",
      "text": "Ahşap tokalı yeşil pelerin."
    },
    {
      "id": "tr-holdout-v2-214",
      "field": "altText",
      "text": "Bisikletin yanında pembe etek."
    },
    {
      "id": "tr-holdout-v2-215",
      "field": "altText",
      "text": "Koyu bağcıklı açık renk spor ayakkabılar."
    },
    {
      "id": "tr-holdout-v2-216",
      "field": "altText",
      "text": "Dik yakada gümüş kolye."
    },
    {
      "id": "tr-holdout-v2-217",
      "field": "altText",
      "text": "Çapraz askılı kot önlük."
    },
    {
      "id": "tr-holdout-v2-218",
      "field": "altText",
      "text": "Kenarı katlanmış gri bere."
    },
    {
      "id": "tr-holdout-v2-219",
      "field": "altText",
      "text": "Oval tokalı kahverengi kemer."
    },
    {
      "id": "tr-holdout-v2-220",
      "field": "altText",
      "text": "Kaplı düğmeli sarı elbise."
    },
    {
      "id": "tr-holdout-v2-221",
      "field": "altText",
      "text": "Büyük cepli kısa ceket."
    },
    {
      "id": "tr-holdout-v2-222",
      "field": "altText",
      "text": "İki omuzda bej şal."
    },
    {
      "id": "tr-holdout-v2-223",
      "field": "altText",
      "text": "Yandan fermuarlı siyah botlar."
    },
    {
      "id": "tr-holdout-v2-224",
      "field": "altText",
      "text": "Yeleğin altında kareli gömlek."
    },
    {
      "id": "tr-holdout-v2-225",
      "field": "altText",
      "text": "Korkuluğun üstünde mavi fular."
    },
    {
      "id": "tr-holdout-v2-226",
      "field": "altText",
      "text": "Yuvarlak saplı örgü sepet."
    },
    {
      "id": "tr-holdout-v2-227",
      "field": "altText",
      "text": "Yandan yırtmaçlı koyu etek."
    },
    {
      "id": "tr-holdout-v2-228",
      "field": "altText",
      "text": "Manşetin yanında yeşil bileklik."
    },
    {
      "id": "tr-holdout-v2-229",
      "field": "altText",
      "text": "Geniş yakalı kırmızı palto."
    },
    {
      "id": "tr-holdout-v2-230",
      "field": "altText",
      "text": "Mokasenlerin üstünde gri çoraplar."
    },
    {
      "id": "tr-holdout-v2-231",
      "field": "altText",
      "text": "Pencere yanında beyaz elbise."
    },
    {
      "id": "tr-holdout-v2-232",
      "field": "altText",
      "text": "Katlanmış mendilli mavi ceket."
    },
    {
      "id": "tr-holdout-v2-233",
      "field": "altText",
      "text": "Sırt çantasında kırmızı kasket."
    },
    {
      "id": "tr-holdout-v2-234",
      "field": "altText",
      "text": "Tahtalar üzerinde kahverengi sandaletler."
    },
    {
      "id": "tr-holdout-v2-235",
      "field": "altText",
      "text": "Bol kollu yeşil bluz."
    },
    {
      "id": "tr-holdout-v2-236",
      "field": "altText",
      "text": "Küçük ilmekli örgü kravat."
    },
    {
      "id": "tr-holdout-v2-237",
      "field": "altText",
      "text": "Önden pensli açık renk pantolon."
    },
    {
      "id": "tr-holdout-v2-238",
      "field": "altText",
      "text": "Gri yünde siyah eldivenler."
    },
    {
      "id": "tr-holdout-v2-239",
      "field": "altText",
      "text": "Kısa askılı pembe çanta."
    },
    {
      "id": "tr-holdout-v2-240",
      "field": "altText",
      "text": "Keten üstünde kumaş kemer."
    },
    {
      "id": "tr-holdout-v2-241",
      "field": "altText",
      "text": "Beli büzgülü mavi etek."
    },
    {
      "id": "tr-holdout-v2-242",
      "field": "altText",
      "text": "Kavisli cepli pembe gömlek."
    },
    {
      "id": "tr-holdout-v2-243",
      "field": "altText",
      "text": "Uzun kollar üstünde gri yelek."
    },
    {
      "id": "tr-holdout-v2-244",
      "field": "altText",
      "text": "Kancada asılı kahverengi şapka."
    },
    {
      "id": "tr-holdout-v2-245",
      "field": "altText",
      "text": "Bastonun yanında kırmızı ayakkabılar."
    },
    {
      "id": "tr-holdout-v2-246",
      "field": "altText",
      "text": "Kapüşon altında desenli fular."
    },
    {
      "id": "tr-holdout-v2-247",
      "field": "altText",
      "text": "Yandan bağlanan yeşil elbise."
    },
    {
      "id": "tr-holdout-v2-248",
      "field": "altText",
      "text": "Mavi boncuklardan bir bileklik."
    },
    {
      "id": "tr-holdout-v2-249",
      "field": "altText",
      "text": "Kolları kıvrılmış beyaz ceket."
    },
    {
      "id": "tr-holdout-v2-250",
      "field": "altText",
      "text": "Açık puantiyeli koyu çoraplar."
    },
    {
      "id": "tr-holdout-v2-251",
      "field": "altText",
      "text": "Ahşap düğmeli bej palto."
    },
    {
      "id": "tr-holdout-v2-252",
      "field": "altText",
      "text": "Salopet altında çizgili bluz."
    },
    {
      "id": "tr-holdout-v2-253",
      "field": "altText",
      "text": "Köşesi yamalı mavi çanta."
    },
    {
      "id": "tr-holdout-v2-254",
      "field": "altText",
      "text": "Yan ayarlı gri pantolon."
    },
    {
      "id": "tr-holdout-v2-255",
      "field": "altText",
      "text": "Basamaklarda siyah botlar."
    },
    {
      "id": "tr-holdout-v2-256",
      "field": "altText",
      "text": "Kalın örgülü sarı bere."
    },
    {
      "id": "tr-holdout-v2-257",
      "field": "altText",
      "text": "Çapraz kapanan kahverengi etek."
    },
    {
      "id": "tr-holdout-v2-258",
      "field": "altText",
      "text": "Askıda keten gömlek."
    },
    {
      "id": "tr-holdout-v2-259",
      "field": "altText",
      "text": "Broşla tutturulmuş kırmızı şal."
    },
    {
      "id": "tr-holdout-v2-260",
      "field": "altText",
      "text": "İki geniş bantlı sandaletler."
    },
    {
      "id": "tr-holdout-v2-261",
      "field": "altText",
      "text": "Lastik etek uçlu yeşil ceket."
    },
    {
      "id": "tr-holdout-v2-262",
      "field": "altText",
      "text": "Büzgülü kollu mavi elbise."
    },
    {
      "id": "tr-holdout-v2-263",
      "field": "altText",
      "text": "Dikdörtgen tokalı siyah kemer."
    },
    {
      "id": "tr-holdout-v2-264",
      "field": "altText",
      "text": "Taş üstünde hasır şapka."
    },
    {
      "id": "tr-holdout-v2-265",
      "field": "altText",
      "text": "Kitabın yanında pembe eldivenler."
    },
    {
      "id": "tr-holdout-v2-266",
      "field": "altText",
      "text": "Dar klapalı gri ceket."
    },
    {
      "id": "tr-holdout-v2-267",
      "field": "altText",
      "text": "Topuğu yamalı çorap."
    },
    {
      "id": "tr-holdout-v2-268",
      "field": "altText",
      "text": "Altın rengi tokalı kahverengi çanta."
    },
    {
      "id": "tr-holdout-v2-269",
      "field": "altText",
      "text": "Koyu ceket altında krem etek."
    },
    {
      "id": "tr-holdout-v2-270",
      "field": "altText",
      "text": "Uzun püsküllü sarı atkı."
    },
    {
      "id": "tr-holdout-v2-271",
      "field": "altText",
      "text": "Hakim yakalı mavi gömlek."
    },
    {
      "id": "tr-holdout-v2-272",
      "field": "altText",
      "text": "Takım üzerinde kareli pelerin."
    },
    {
      "id": "tr-holdout-v2-273",
      "field": "altText",
      "text": "Cırt cırtlı beyaz spor ayakkabılar."
    },
    {
      "id": "tr-holdout-v2-274",
      "field": "altText",
      "text": "Kumaş düğmeli pembe bluz."
    },
    {
      "id": "tr-holdout-v2-275",
      "field": "altText",
      "text": "Derin cepli yeşil pantolon."
    },
    {
      "id": "tr-holdout-v2-276",
      "field": "altText",
      "text": "Kol altında gümüş saat."
    },
    {
      "id": "tr-holdout-v2-277",
      "field": "altText",
      "text": "Çıkarılabilir kapüşonlu koyu palto."
    },
    {
      "id": "tr-holdout-v2-278",
      "field": "altText",
      "text": "Kemerli keten elbise."
    },
    {
      "id": "tr-holdout-v2-279",
      "field": "altText",
      "text": "Şemsiye yanında gri kasket."
    },
    {
      "id": "tr-holdout-v2-280",
      "field": "altText",
      "text": "Ön cepli sarı önlük."
    },
    {
      "id": "tr-holdout-v2-281",
      "field": "altText",
      "text": "Kapı yanında yeşil çanta."
    },
    {
      "id": "tr-holdout-v2-282",
      "field": "altText",
      "text": "Yan cepli kırmızı etek."
    },
    {
      "id": "tr-holdout-v2-283",
      "field": "altText",
      "text": "Dikişleri görünen deri botlar."
    },
    {
      "id": "tr-holdout-v2-284",
      "field": "altText",
      "text": "Saç örgüsü desenli beyaz kazak."
    },
    {
      "id": "tr-holdout-v2-285",
      "field": "altText",
      "text": "Düz yakalı koyu gömlek."
    },
    {
      "id": "tr-holdout-v2-286",
      "field": "altText",
      "text": "Kuş biçimli gümüş broş."
    },
    {
      "id": "tr-holdout-v2-287",
      "field": "altText",
      "text": "Açık elbisede mavi kemer."
    },
    {
      "id": "tr-holdout-v2-288",
      "field": "altText",
      "text": "Atkı üzerinde siyah bere."
    },
    {
      "id": "tr-holdout-v2-289",
      "field": "altText",
      "text": "Dirsek yamalı kadife ceket."
    },
    {
      "id": "tr-holdout-v2-290",
      "field": "altText",
      "text": "İskelede kırmızı sandaletler."
    },
    {
      "id": "tr-holdout-v2-291",
      "field": "altText",
      "text": "Örgü yelek altında krem bluz."
    },
    {
      "id": "tr-holdout-v2-292",
      "field": "altText",
      "text": "Belirgin ütü çizgili siyah pantolon."
    },
    {
      "id": "tr-holdout-v2-293",
      "field": "altText",
      "text": "Ahşap sandalyede mavi şal."
