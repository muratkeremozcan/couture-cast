{
  "version": 2,
  "outputDirectory": "public",
  "ignoreCommand": "node ../../scripts/vercel-preview-inputs.mjs --ignore",
  "functions": {
    "api/index.ts": {
      "maxDuration": 25,
      "memory": 1024,
      "includeFiles": "dist/src/modules/share-cards/assets/**"
    },
    "api/realtime.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/realtime",
      "destination": "/api/realtime"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
