# Secrets only - all other config is in code (playwright/support/config/environments.ts)
# Choose one block to target preview/prod/local and fill in the placeholders.

# Preview (cloud) - default non-production target
SUPABASE_URL=https://your-preview-ref.supabase.co
SUPABASE_ANON_KEY=your-preview-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-preview-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-preview-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-preview-anon-key

# Wardrobe upload relay and private analytics subject derivation
WARDROBE_UPLOAD_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ANALYTICS_ID_SECRET=replace-with-a-separate-at-least-32-byte-secret

# Affiliate commerce (story 5.1).
# COMMERCE_CLICK_TOKEN_SECRET keys the HMAC that turns an internal
# AffiliateClick.id into the opaque token a partner URL carries. It must never
# share a value with any other secret here: sharing would let a holder of one
# derive the others. Rotating it invalidates every outstanding click token, so
# conversions posted against a pre-rotation token stop matching; rotate only
# alongside a partner cutover, and expect a short tail of matched: false.
COMMERCE_CLICK_TOKEN_SECRET=replace-with-a-separate-at-least-32-byte-secret
# One signing secret per affiliate partner, named for that partner's slug. The
# name shape is enforced twice, by a database check constraint on
# CommercePartner.webhook_secret_ref and again at runtime, because the webhook
# resolves it as process.env[<value from a database row>].
# Pattern: COMMERCE_PARTNER_<SLUG_IN_UPPER_SNAKE>_WEBHOOK_SECRET
#
# LEAVE THIS COMMENTED OUT FOR LOCAL AND TEST RUNS. The seeded `sample-partner`
# catalog row is signable without an operator exporting anything: with no value
# set, `resolvePartnerWebhookSecret` falls back to
# `buildTestOnlyPartnerWebhookSecret`, which is the same value the integration
# and Playwright suites sign with. Setting it here to the placeholder below
# makes the server sign with the placeholder while the suites keep signing with
# the fallback, so every valid webhook turns into a 401 while the whole
# signature-rejection matrix still passes. That failure reads like a broken
# endpoint, not a misconfigured secret.
#
# Uncomment and set a real value only for a deployed environment with a real
# partner.
# COMMERCE_PARTNER_SAMPLE_PARTNER_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes

# Premium subscriptions (story 5.2). Server-side only; the web app gains NO
# Stripe dependency (Checkout is a redirect; sessions come from our API).
#
# LEAVE THE WEBHOOK/AUTH SECRETS COMMENTED OUT FOR LOCAL AND TEST RUNS - same
# trap as the affiliate secret above: a set-but-placeholder value makes the
# server verify with the placeholder while the suites sign with the test-only
# fallback, so every valid webhook 401s while the rejection matrix still
# passes. With nothing set, allowsTestOnlySecrets() environments fall back to
# the deterministic test-only values the suites sign with.
#
# STRIPE_SECRET_KEY: server only; use a test-mode key (sk_test_...) in every
# non-production environment. With no key set, test/local runs use the
# deterministic fake Stripe client (outbound calls only - webhook signature
# verification always runs the real stripe library).
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET: from the Stripe webhook endpoint config (whsec_...).
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-at-least-32-random-bytes
# Price ids from the Stripe Products/Prices provisioning step (runbook).
# STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_your-monthly-price-id
# STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_your-annual-price-id
# REVENUECAT_SECRET_API_KEY: REST reads + Stripe receipt forwarding. With no
# key set, test/local runs use the deterministic fake ledger.
# REVENUECAT_SECRET_API_KEY=sk_your-revenuecat-secret-api-key
# REVENUECAT_WEBHOOK_AUTH: the static Authorization header value RevenueCat
# sends with every webhook, >=32 bytes, compared in constant time.
# REVENUECAT_WEBHOOK_AUTH=replace-with-at-least-32-random-bytes
# Public SDK keys for the mobile app (react-native-purchases).
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_your-revenuecat-apple-key
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your-revenuecat-google-key

# PostHog (canonical source of truth for web + mobile)
# apps/web and apps/mobile read these canonical vars.
# apps/mobile reads these through app config extra values.
POSTHOG_API_KEY=phc_your_project_key
POSTHOG_HOST=https://us.i.posthog.com

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
# For Upstash/Prod, set REDIS_TLS=true and REDIS_URL=rediss://:<token>@<host>:<port>
REDIS_TLS=false

UPSTASH_REDIS_REST_URL=***
UPSTASH_REDIS_REST_TOKEN=***

# Expo Push
# EXPO_TOKEN: create an access token in Expo (Account Settings → Access Tokens or `npx eas token:create`).
# Used by EAS workflows and the API push client.
EXPO_TOKEN=your-expo-access-token

# Vercel Preview protection bypass (optional)
# If Vercel Preview deployments are protected, create a 32-character bypass secret in Vercel and set it here (and in CI).
VERCEL_AUTOMATION_BYPASS_SECRET=your-32-character-bypass-secret

# Vercel Preview URL discovery (optional)
# If set, `TEST_ENV=preview` can derive the stable per-branch Preview URL when `PREVIEW_WEB_E2E_BASE_URL` is not set.
VERCEL_WEB_PROJECT_SLUG=couture-cast-web
VERCEL_API_PROJECT_SLUG=couture-cast-api
VERCEL_TEAM_SLUG=muratkeremozcans-projects

SUPABASE_DB_PREVIEW_PW=your-preview-db-password

SUPABASE_DB_PROD_PW=your-prod-db-password

DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Comma-separated browser origins allowed to call the API directly.
HTTP_CORS_ORIGIN=http://localhost:3000

# Guardian invitation flow
# GUARDIAN_INVITE_WEB_BASE_URL powers links like https://app.couturecast.test/guardian/accept?token=...
GUARDIAN_INVITE_WEB_BASE_URL=http://localhost:3000
# GUARDIAN_INVITE_JWT_SECRET signs 7-day guardian invitation tokens.
GUARDIAN_INVITE_JWT_SECRET=your-guardian-invite-jwt-secret
# Defaults to true so adult accounts automatically drop guardian-linked access on the 18th birthday sweep.
GUARDIAN_EMANCIPATION_REVOKE_CONSENTS=true

# Optional local Grafana stack for OTEL traces + metrics
# Start it with: npm run observability:local:up
# Then point the API OTLP exporter at the local LGTM endpoint.
# GRAFANA_OTLP_ENDPOINT=http://127.0.0.1:4318
# GRAFANA_OTLP_AUTH_HEADER=disabled
# OTEL_SERVICE_NAME=couturecast-api

# Weather API Ingestion config
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHERAPI_API_KEY=your-weatherapi-api-key
WEATHER_REFRESH_MINUTES=5
WEATHER_PROVIDER_MODE=openweather
WEATHER_INGESTION_TARGETS_JSON='[{"locationKey":"new-york-ny","locationName":"New York, NY","latitude":40.7128,"longitude":-74.0060}]'

# Wardrobe smart tagging engine and model location
# Production uses local FashionCLIP model snapshot prepared at GARMENT_TAGGING_MODEL_DIR.
# GARMENT_TAGGING_ENGINE=fashion-clip (default) or GARMENT_TAGGING_ENGINE=fixture (test only)
# Production must use an absolute path mounted into the wardrobe worker process.
GARMENT_TAGGING_MODEL_DIR=/absolute/path/to/couture-cast/apps/api/.cache/garment-tagging-model
GARMENT_TAGGING_ENGINE=fashion-clip
