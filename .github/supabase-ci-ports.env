# The host ports local Supabase binds in CI: the one source every CI job reads.
#
# supabase/config.toml keeps 5432x for developers. Those sit inside Linux's ephemeral
# range (32768-60999), so an outgoing connection can hold one as its local port: the
# runner's own HTTPS connection (Runner.Listener) held 54322 for a whole job in mobile e2e
# run 43079319997, and the start burned its 10 minute budget waiting for it. These ports
# are below 32768, outside the Linux range and macOS's (49152-65535), so no client
# socket takes them.
#
# The Supabase CLI reads SUPABASE_<SECTION>_PORT over config.toml. The
# configure-ci-supabase-ports action exports these to $GITHUB_ENV with the URLs derived
# from them (LOCAL_DATABASE_URL, SUPABASE_LOCAL_API_URL, SUPABASE_LOCAL_MAILPIT_URL), and
# scripts/lib/local-supabase-ports.mjs reads them in every script and guard.
SUPABASE_API_PORT=24321
SUPABASE_DB_PORT=24322
SUPABASE_DB_SHADOW_PORT=24320
SUPABASE_STUDIO_PORT=24323
SUPABASE_INBUCKET_PORT=24324
SUPABASE_ANALYTICS_PORT=24327
SUPABASE_DB_POOLER_PORT=24329
